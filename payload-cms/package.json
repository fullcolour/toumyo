{
  "name": "toumyou-payload-cms",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "build:cloudflare": "opennextjs-cloudflare build",
    "dev": "next dev",
    "preview": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "payload migrate:create",
    "migrate": "payload migrate",
    "check": "npx tsc --noEmit && npm run generate:types",
    "deploy": "npm run check && npm run build:cloudflare && opennextjs-cloudflare deploy",
    "deploy:guide": "bash scripts/deploy-payload.sh"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.11.0",
    "@payloadcms/db-d1-sqlite": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/storage-r2": "^3.0.0",
    "cross-env": "^10.1.0",
    "graphql": "^16.8.1",
    "next": "^16.3.0",
    "payload": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.92.0"
  }
}
