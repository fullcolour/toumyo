{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "toumyou-payload-cms",
  "account_id": "9bbf527fc892e63a600961322cc8cb39",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "cms.toumyou.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "rin",
      "database_id": "11cb37d5-b65a-4101-8fea-2c5d6a4c1ae2",
      "remote": true
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "image"
    }
  ],
  "vars": {
    "PAYLOAD_PUBLIC_SERVER_URL": "https://cms.toumyou.com"
  }
}
